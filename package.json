{
  "name": "dt-tennis-mini",
  "version": "1.0.0",
  "description": "ДТ — Telegram Mini App теннисного клуба: расписание, свободная игра, магазин, о клубе",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit",
    "smoke": "node smoke.mjs && node --experimental-transform-types --disable-warning=ExperimentalWarning tests/miniapp-e2e.mjs",
    "test:security": "node --experimental-transform-types --disable-warning=ExperimentalWarning tests/booking-security.mjs",
    "test:postgres": "node --experimental-transform-types --disable-warning=ExperimentalWarning tests/postgres-concurrency.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwert11232/mini.git"
  },
  "bugs": {
    "url": "https://github.com/qwert11232/mini/issues"
  },
  "homepage": "https://github.com/qwert11232/mini#readme",
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
