# ─── Telegram ────────────────────────────────────────────────────────────────
# Имя бота клуба (без @), используется для ссылок и deep-link из мини-аппа
VITE_TELEGRAM_BOT_NAME=
# Публичный URL мини-аппа (https), на него ссылается меню бота
VITE_APP_URL=
# Токен бота: только для серверной части (валидация initData, уведомления).
# В браузерный бандл НЕ попадает.
TELEGRAM_BOT_TOKEN=

# ─── Администрирование ───────────────────────────────────────────────────────
# Ссылка на бота управления клубом (панель админа)
VITE_ADMIN_BOT_URL=

# ─── Бэкенд (следующий этап) ─────────────────────────────────────────────────
VITE_API_BASE_URL=
