# ─── Neon (Vercel → Storage → Neon) ───────────────────────────────────────────
# Pooled-строка подключения, обязательно с sslmode=require.
# Vercel подставляет её автоматически при подключении интеграции Neon.
DATABASE_URL=

# ─── Telegram-бот ────────────────────────────────────────────────────────────
# Токен из @BotFather. Только сервер: нужен для проверки initData и уведомлений.
# НЕ добавляйте префикс VITE_ — иначе токен попадёт в браузерный бандл.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ и публичный адрес мини-аппа — для ссылок и меню бота
VITE_TELEGRAM_BOT_NAME=
VITE_APP_URL=https://dt-tennis.vercel.app
# Ссылка на бота администрирования клуба (панель админа)
VITE_ADMIN_BOT_URL=

# ─── Режимы ──────────────────────────────────────────────────────────────────
# 1 — включить демонстрационный вход без Telegram (только Preview-окружение!)
PREVIEW_MODE=0
