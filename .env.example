# ─── Neon (Vercel → Storage → Neon) ───────────────────────────────────────────
# Pooled-строка подключения. Задаётся в Vercel → Settings → Environment Variables.
# Локально не нужна: /api эмулируется плагином Vite, данные лежат в .preview/db.json.
DATABASE_URL=

# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен из @BotFather. Только сервер: проверка initData, уведомления, админ-бот.
# НЕ добавляйте префикс VITE_ — иначе секрет попадёт в браузерный бандл.
TELEGRAM_BOT_TOKEN=

# Секрет webhook: Telegram присылает его в X-Telegram-Bot-Api-Secret-Token.
# Случайная строка из A–Z, a–z, 0–9, _ и -; длина 1–256 символов.
TELEGRAM_WEBHOOK_SECRET=
# Токен для /api/admin/setup и /api/admin/migrate-bot-state. Если переменная
# задана, она имеет приоритет над SETUP_TOKEN (пустое значение закроет доступ).
# Если используется SETUP_TOKEN, не создавайте ADMIN_SETUP_TOKEN в окружении.
# /api/admin/setup применяет также SEED и опасен для существующей базы.
ADMIN_SETUP_TOKEN=

# Токен для /api/bot/setup (в том числе ?mode=menu). Для миграции состояния
# используется только при отсутствии переменной ADMIN_SETUP_TOKEN. Без SETUP_TOKEN
# bot/setup доступен только со свежей подписью initData администратора из Mini App.
SETUP_TOKEN=

# Публичные значения (можно хранить в репозитории)
VITE_TELEGRAM_BOT_NAME=testtesttennisbot
# HTTPS-адрес Mini App без query/fragment: используется для webhook и web_app.
# Если не задан, используется адрес действующего проекта; для других проектов укажите явно.
VITE_APP_URL=https://mini-seven-xi.vercel.app
VITE_ADMIN_BOT_URL=https://t.me/testtesttennisbot

# ─── Администраторы ──────────────────────────────────────────────────────────
# Числовые Telegram ID через запятую; только они дают доступ к админ-панели.
# По умолчанию — ID владельца 793536041. Пустая переменная отключает доступ.
# Username и метка role в базе не дают прав; добавьте ID каждого администратора.
ADMIN_TELEGRAM_IDS=793536041

# ─── Оплата ──────────────────────────────────────────────────────────────────
# Оплата на ресепшене: заказы создаются со статусом reserved, онлайн-платежей нет.
PAYMENTS_MODE=reception

# Демо без Telegram работает только в локальном `npm run dev` (эмулятор API).
# Production и Vercel Preview требуют подписанный initData Telegram.
