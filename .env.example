# ─── Neon (Vercel → Storage → Neon) ───────────────────────────────────────────
# Pooled-строка подключения. Задаётся в Vercel → Settings → Environment Variables.
# Локально не нужна: /api эмулируется плагином Vite, данные лежат в .preview/db.json.
DATABASE_URL=

# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен из @BotFather. Только сервер: проверка initData, уведомления, админ-бот.
# НЕ добавляйте префикс VITE_ — иначе секрет попадёт в браузерный бандл.
TELEGRAM_BOT_TOKEN=

# Секрет webhook: Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token,
# поэтому посторонние не смогут слать боту поддельные апдейты. Любая случайная строка.
TELEGRAM_WEBHOOK_SECRET=
# Необязательный токен для /api/admin/setup и /api/admin/migrate-bot-state.
# /api/admin/setup накатывает схему И демо-данные: повторный вызов на рабочей базе
# требует резервной копии, так как SEED может сдвинуть даты занятий и окон.
# migrate-bot-state создаёт только новую таблицу bot_dialog_state, без SEED.
ADMIN_SETUP_TOKEN=

# Токен для /api/bot/setup и /api/admin/migrate-bot-state. Нужен в ?token=...
# Для admin-эндпоинтов подходит также ADMIN_SETUP_TOKEN. Без SETUP_TOKEN настройка
# webhook доступна только по подписанной сессии администратора из мини-аппа;
# migrate-bot-state без одного из этих токенов недоступен.
SETUP_TOKEN=

# Публичные значения (можно хранить в репозитории)
VITE_TELEGRAM_BOT_NAME=testtesttennisbot
VITE_APP_URL=https://mini-seven-xi.vercel.app
VITE_ADMIN_BOT_URL=https://t.me/testtesttennisbot

# ─── Администраторы ──────────────────────────────────────────────────────────
# Числовые Telegram ID через запятую (надёжнее username: его можно сменить).
# 793536041 — владелец (@nikita_tsk); зашит по умолчанию в api/_lib/telegram.ts
ADMIN_TELEGRAM_IDS=793536041
# Username администраторов через запятую, без @ — запасной способ входа в админку.
ADMIN_TELEGRAM_USERNAMES=nikita_tsk

# ─── Оплата ──────────────────────────────────────────────────────────────────
# Оплата на ресепшене: заказы создаются со статусом reserved, онлайн-платежей нет.
PAYMENTS_MODE=reception

# ─── Режимы ──────────────────────────────────────────────────────────────────
# 1 — демонстрационный вход без Telegram (только Preview-окружение Vercel!)
PREVIEW_MODE=0
